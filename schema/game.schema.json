{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/porthub-feed/catalog/schema/game.schema.json",
  "title": "PortHub Catalog",
  "description": "One record per Android port, decompilation, recompilation or engine reimplementation.",
  "type": "object",
  "required": ["version", "games"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "description": "ISO-8601 timestamp of the build" },
    "games": { "type": "array", "items": { "$ref": "#/$defs/game" } }
  },
  "$defs": {
    "game": {
      "type": "object",
      "required": ["id", "title", "links"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable slug used for deep links and favourites. Never reuse."
        },
        "title": { "type": "string", "minLength": 1 },
        "originalTitle": { "type": "string", "description": "The retail game this port reconstructs" },
        "year": { "type": "integer", "minimum": 1970, "maximum": 2100 },
        "platforms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Platforms of the ORIGINAL release: N64, PS1, PC, Saturn..."
        },
        "developer": { "type": "string" },
        "portType": {
          "type": "string",
          "enum": ["recompilation", "decompilation", "engine", "source-port", "unknown"]
        },
        "status": {
          "type": "string",
          "enum": ["stable", "beta", "alpha", "wip", "archived", "unknown"]
        },
        "engine": { "type": "string" },
        "description": { "type": "string", "maxLength": 400 },
        "steamAppId": {
          "type": "integer",
          "minimum": 1,
          "description": "Appid of the ORIGINAL game on Steam. Enables official capsule art from Steam's CDN; omit when the game is not on Steam."
        },
        "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supported": { "type": "boolean", "default": true },
            "minAndroid": { "type": "string", "description": "e.g. 9.0" },
            "abis": {
              "type": "array",
              "items": { "type": "string", "enum": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64", "universal"] }
            },
            "requiresGameFiles": {
              "type": "string",
              "enum": ["none", "owned", "required", "unknown"],
              "description": "none = standalone, owned = user supplies their own copy of the original game"
            },
            "notes": { "type": "string", "maxLength": 240 }
          }
        },
        "artwork": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cover": { "type": "string", "format": "uri" },
            "hero": { "type": "string", "format": "uri" },
            "screenshots": { "type": "array", "items": { "type": "string", "format": "uri" }, "maxItems": 12 },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string", "format": "uri" },
            "releases": { "type": "string", "format": "uri" },
            "website": { "type": "string", "format": "uri" },
            "discord": { "type": "string", "format": "uri" },
            "wiki": { "type": "string", "format": "uri" }
          }
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "kind": { "type": "string", "enum": ["apk", "zip", "store", "source"], "default": "apk" },
              "url": { "type": "string", "format": "uri" },
              "version": { "type": "string" },
              "sizeMb": { "type": "number", "minimum": 0 },
              "abi": { "type": "string" }
            }
          }
        },
        "license": { "type": "string", "description": "SPDX id when known" },
        "lastUpdated": { "type": "string", "description": "YYYY-MM-DD" },
        "stars": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "owner/repo pairs this record was built from. Build metadata, not shown in the app."
        }
      }
    }
  }
}
